// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  employee
}

enum DeviceStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
  RESERVED
}

enum CheckoutType {
  CHECKOUT
  RESERVATION
}

enum CheckoutStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  AUTO_RELEASED
}

model User {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String     @unique
  password  String
  role      UserRole @default(employee)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  checkouts Checkout[]
  waitlist Waitlist[]
}

model Device {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  category     String
  serial_no    String       @unique
  qr_code      String       @unique
  image_url    String
  qr_image_url String
  status       DeviceStatus @default(AVAILABLE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  checkouts    Checkout[]
  waitlist Waitlist[]
}

model Checkout {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  deviceId           String         @db.ObjectId
  device             Device         @relation(fields: [deviceId], references: [id])
  userId             String         @db.ObjectId
  user               User           @relation(fields: [userId], references: [id])
  type               CheckoutType
  status             CheckoutStatus @default(ACTIVE)
  startTime          DateTime
  expectedReturnTime DateTime
  returnedAt         DateTime?
  createdAt          DateTime       @default(now())
}

enum WaitlistStatus {
  PENDING     
  NOTIFIED    
  FULFILLED   
  CANCELLED 
}

model Waitlist {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  deviceId   String         @db.ObjectId
  device     Device         @relation(fields: [deviceId], references: [id])
  userId     String         @db.ObjectId
  user       User           @relation(fields: [userId], references: [id])
  status     WaitlistStatus @default(PENDING)
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([deviceId, status])
  @@unique([deviceId, userId, status])
}